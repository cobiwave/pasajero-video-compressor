{
  "name": "pasajero-video-compressor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PASAJERO Video Compressor: herramienta local para comprimir videos con ffmpeg para redes sociales y la web.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "start": "node dist-server/server/index.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=18"
  }
}
